# Copy to .env and fill in values for your environment

# Kafka
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=github-events

# Spark streaming
TRIGGER_INTERVAL=30 seconds
CHECKPOINT_DIR=/tmp/streamline-checkpoints

# Storage: "local" or "s3"
OUTPUT_STORAGE=local
OUTPUT_DIR=./data/lake

# S3 / MinIO (only needed when OUTPUT_STORAGE=s3)
S3_BUCKET=streamline
S3_PREFIX=lake
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=streamline
S3_SECRET_KEY=streamline
